class Solution:
    def peopleAwareOfSecret(self, n: int, delay: int, forget: int) -> int:
        MOD = 10**9 + 7
        dp = [0] * (n + 1)
        dp[1] = 1
        share_sum = 0

        for day in range(2, n + 1):
            # Add new people who start sharing today
            if day - delay >= 1:
                share_sum = (share_sum + dp[day - delay]) % MOD
            # Remove people who forget today
            if day - forget >= 1:
                share_sum = (share_sum - dp[day - forget]) % MOD
            dp[day] = share_sum % MOD

        return sum(dp[max(1, n - forget + 1): n + 1]) % MOD
